{
  "name": "@qeet-id/tanstack",
  "version": "0.1.0",
  "description": "Qeet ID for TanStack Start: sign-in on Qeet ID's hosted pages, an encrypted cookie session on your server, and route protection.",
  "author": "Qeet Group",
  "homepage": "https://github.com/qeetgroup/qeet-id-tanstack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeet-id-tanstack.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeet-id-tanstack/issues"
  },
  "keywords": [
    "qeet",
    "qeet-id",
    "identity",
    "authentication",
    "oidc",
    "oauth",
    "pkce",
    "session",
    "tanstack",
    "tanstack-start",
    "tanstack-router",
    "react",
    "sdk"
  ],
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --diagnostic-level=error .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "verify": "bun run typecheck && bun run check && bun run test && bun run build && bun run check:package",
    "prepublishOnly": "bun run verify"
  },
  "peerDependencies": {
    "@qeet-id/node": "^0.1.0",
    "@qeet-id/react": "^0.1.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.169.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.5",
    "@qeet-id/node": "link:@qeet-id/node",
    "@qeet-id/react": "link:@qeet-id/react",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@qeet-id/node": {
      "optional": true
    },
    "@qeet-id/react": {
      "optional": true
    }
  }
}
